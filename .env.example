# Pasta raiz de trabalho. As subpastas entrada/, enviados/, erro/, processado/ e logs/
# sao derivadas e criadas automaticamente a cada inicio do servico.
# Obrigatoria, sem default.
PASTA_BASE=

# URL local da instancia Evolution API.
EVOLUTION_API_URL=http://localhost:8080

# Chave de autenticacao da instancia Evolution API.
# Obrigatoria, sem default seguro. Gerada automaticamente pelo install.ps1 (Etapa 11)
# e sincronizada com docker-compose.yml.
EVOLUTION_API_KEY=

# Nome da instancia dentro da Evolution API.
EVOLUTION_INSTANCE=Q-Zap

# Senha do Postgres usado internamente pela Evolution API (ver docker-compose.yml).
# Obrigatoria, sem default seguro. Gerada automaticamente pelo install.ps1 (Etapa 11).
POSTGRES_PASSWORD=

# Porta local onde o Q-Zap escuta o webhook de status de conexao da Evolution API (RF13).
WEBHOOK_PORT=3939

# Numero que recebe os resumos de envio/erro (RF18).
# Obrigatoria, sem default.
NUMERO_ADMIN=

# Faixa de delay aleatorio (segundos) entre envios consecutivos (RF09).
DELAY_MIN_SEC=5
DELAY_MAX_SEC=15

# Formula de duracao do indicador "digitando" (RF10):
# min(TYPING_BASE_MS + tamanho_mensagem * TYPING_MS_POR_CARACTER, TYPING_MAX_MS) + jitter
TYPING_BASE_MS=1500
TYPING_MS_POR_CARACTER=40
TYPING_MAX_MS=8000

# Limite diario de mensagens enviadas por numero (RF11).
# A definir por cliente na instalacao, sem default seguro.
LIMITE_DIARIO_POR_NUMERO=

# Maximo de tentativas de envio antes de considerar erro (RF12).
RETRY_MAX_TENTATIVAS=3

# Backoff exponencial (RF12): min(RETRY_BASE_MS * 2^(tentativa-1), RETRY_MAX_MS) + jitter
RETRY_BASE_MS=5000
RETRY_MAX_MS=60000

# Nivel de verbosidade do logger pino (trace, debug, info, warn, error, fatal).
LOG_LEVEL=info
